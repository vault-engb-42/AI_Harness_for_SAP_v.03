# Dependencies
node_modules/

# Logs / runtime noise
*.log
npm-debug.log*

# OS junk
.DS_Store
Thumbs.db

# Local env / secrets — never commit
.env
.env.*
!.env.example

# Editor
.vscode/
.idea/

# Session handoffs — ephemeral, session-scoped continuity notes; never commit (rules/handoffs.md)
.handoffs/

# Local working-progress folder — design docs, build contracts, architecture specs,
# reference extracts. Deliberately NOT published (see README). Stays on disk, never committed.
docs/

# Third-party demo corpus source — unlicensed (all-rights-reserved), never redistributed.
# Present locally inside each demo for reproduction; the analysis + proof beside it ARE tracked,
# the source is NOT (see demos/FETCH.md). Operator-approved 2026-07-27.
demos/*/before/source/
demos/*/after/modernised-source/

# Advisory-hook runtime output (record-run / atc-on-activate). Telemetry and obligations are
# per-machine state, not repository content — the seeded baselines beside them ARE tracked.
.claude/state/run-log.jsonl
.claude/state/atc-owed.json

# Hook-test scratch workspaces. Created and torn down within a run; a run interrupted mid-suite
# (e.g. a timeout SIGTERM) skips teardown and leaves the empty dir behind, so ignore it outright.
.claude/hooks/test/fixtures/
