{
  "name": "sap-abap-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SAP ABAP Claude Code harness — MCP-ADT bridge + hooks",
  "scripts": {
    "test": "node --test .claude/hooks/test/abap-checks.test.js .claude/hooks/test/hooks.test.js .claude/hooks/test/advisory-hooks.test.js .claude/scripts/test/model-tier.test.js .claude/test/lane-contracts.test.js mcp-adt-bridge/test/bridge.test.js \"analyser/test/*.test.js\" \"oracle/test/*.test.js\" \"greenfield/test/*.test.js\" \"moderniser/test/*.test.js\" \"integrations/test/*.test.js\" \"sap-adt-sidecar/test/lib.test.js\" \"sap-adt-sidecar/test/write.test.js\" \"sap-adt-sidecar/test/aunit.test.js\" \"sap-adt-sidecar/test/server.test.js\" \"sap-adt-sidecar/test/usage-signal.test.js\"",
    "test:bridge": "node --test mcp-adt-bridge/test/bridge.test.js",
    "test:hooks": "node --test .claude/hooks/test/abap-checks.test.js .claude/hooks/test/hooks.test.js .claude/hooks/test/advisory-hooks.test.js",
    "test:scripts": "node --test .claude/scripts/test/model-tier.test.js",
    "test:analyser": "node --test \"analyser/test/*.test.js\"",
    "test:oracle": "node --test \"oracle/test/*.test.js\"",
    "test:greenfield": "node --test \"greenfield/test/*.test.js\"",
    "test:moderniser": "node --test \"moderniser/test/*.test.js\"",
    "test:corpus": "node --test \"moderniser/test/corpus/*.corpus.test.js\"",
    "test:all": "npm test && npm run test:corpus",
    "test:sidecar": "node --test sap-adt-sidecar/test/lib.test.js sap-adt-sidecar/test/write.test.js sap-adt-sidecar/test/aunit.test.js sap-adt-sidecar/test/server.test.js sap-adt-sidecar/test/usage-signal.test.js",
    "test:live": "node --test mcp-adt-bridge/test/bridge.live.test.js sap-adt-sidecar/test/sidecar.live.test.js analyser/test/live/analyser.live.test.js",
    "test:live:write": "node --test sap-adt-sidecar/test/sidecar.write.live.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@abaplint/core": "2.119.53",
    "fast-xml-parser": "^5.9.3"
  },
  "license": "MIT"
}
