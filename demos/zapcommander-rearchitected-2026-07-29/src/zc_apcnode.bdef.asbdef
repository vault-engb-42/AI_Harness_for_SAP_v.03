// Projection behavior definition for ZC_ApcNode.
// Thin layer - exposes only what the UI/OData service requires.
// The interface BDEF (ZI_ApcNode) remains the authoritative definition.

projection;

define behavior for ZC_ApcNode alias NodeProj
  use draft
{
  use create;
  use update;
  use delete;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use action createChild;
  use action attachContent;
}
